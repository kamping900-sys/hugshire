# ─────────────────────────────────────────────────────────────
# Hugshire environment. Copy to .env.local (dev) or set in your host (prod).
# Never commit real values. See docs/SETUP_GUIDE.md for where each comes from.
# ─────────────────────────────────────────────────────────────

# sandbox = labelled test providers, no money moves. live = real providers (refuses to boot without everything below).
HUGSHIRE_MODE=sandbox
APP_URL=http://localhost:3200

# pglite:<dir> is embedded Postgres for local dev only. Use a real Postgres URL anywhere else.
#   docker compose up -d  →  postgres://hugshire:hugshire_local_only@localhost:5433/hugshire
DATABASE_URL=pglite:.data/hugshire
SESSION_SECRET=replace-with-64-random-characters-openssl-rand-hex-32
ADMIN_EMAILS=admin@hugshire.test

# dev = 6-digit email codes printed to the server log (refused in live). privy = email/Google via Privy.
AUTH_PROVIDER=dev
PRIVY_APP_ID=
# ES256 public key from Privy dashboard → Configuration → App settings → Verification key (PEM, \n escaped)
PRIVY_VERIFICATION_KEY=

# Coinbase Developer Platform: Secret API key (portal.cdp.coinbase.com → API keys) and webhook subscription secret
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WEBHOOK_SECRET=

# NEAR Intents 1Click (partners.near-intents.org). Without a key every quote costs an extra 0.25%.
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=

# NEAR
NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://rpc.mainnet.near.org
NEAR_VAULT_CONTRACT=
NEAR_OPERATOR_ACCOUNT=
# Function-call-only access key restricted to the Vault (supply, distribute_yield). Never a full-access key.
NEAR_OPERATOR_PRIVATE_KEY=
RHEA_LENDING_CONTRACT=contract.main.burrow.near
NEAR_USDC_CONTRACT=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1

# Uploads: local (dev) or s3 (Cloudflare R2 / any S3-compatible)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Community Heart Pool treasury: a Sputnik DAO v2 (manageable in Trezu). Optional.
# Hugshire's key must hold ONLY the proposer role; council members approve payouts in the DAO.
POOL_DAO_ACCOUNT=
POOL_PROPOSER_ACCOUNT=
POOL_PROPOSER_PRIVATE_KEY=

# Monitoring
ALERT_WEBHOOK_URL=
WORKER_SECRET=

# Set to 0 to stop the in-process sandbox scheduler (then run `npm run worker`).
HUGSHIRE_INPROCESS_WORKER=1
